{
  "name": "slow-burn-frontier",
  "version": "1.0.0",
  "description": "Deterministic, zero-micro orbital sector conquest and logistics strategy game built with Colyseus 0.18",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "tsx node_modules/mocha/bin/mocha.js test/**/*.test.ts --timeout 15000 --exit",
    "client:dev": "vite src/client",
    "client:build": "vite build src/client"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.48",
    "@colyseus/sdk": "^0.18.10",
    "colyseus": "^0.18.12",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@types/chai": "^5.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.1",
    "chai": "^5.2.0",
    "mocha": "^11.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
